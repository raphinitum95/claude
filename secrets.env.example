# Copy to secrets.env (git-ignored) and fill in. Never commit real values.
RECAPTCHA_BYPASS_TOKEN_QA=
RECAPTCHA_BYPASS_TOKEN_UAT=
RECAPTCHA_BYPASS_TOKEN_PROD=

# Workbook tokens that must not live in Excel (only needed if you re-enable the Zscaler/Okta login rows):
# RR_VAR_DT_ZSCALERUSER=
# RR_VAR_DT_ZSCALERPASSWORD=

# API tests: the key and bearer token of an API sheet can live here instead of in the workbook (RR_VAR_<COLUMN NAME>); a value here wins over the cell.
# RR_VAR_DT_APIKEY=
# RR_VAR_DT_BEARERTOKEN=
# Where API request templates (JSON bodies) are when the workbook's own path (the L: drive) is not there:
# RR_API_TEMPLATES_DIR=
